# Claude Code
# No API key needed if you have Claude Max — the SDK uses your local CLI auth.
# Only set ANTHROPIC_API_KEY if you're using API-based auth instead.
# ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_CODE_WORKING_DIR=/Users/brianfoody/apps/personal/teamchildhood
WOODPECKER_AUTH_TOKEN=28aca8fad51bfb1433ee432467d002873a6268dc9fa460f6299ebb5da22ba2b9
NEXT_PUBLIC_WOODPECKER_AUTH_TOKEN=28aca8fad51bfb1433ee432467d002873a6268dc9fa460f6299ebb5da22ba2b9

# Twilio Configuration (optional - for SMS features)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_RECIPIENT_PHONE_NUMBER=

# Tavily Search API (optional - for web search)
TAVILY_API_KEY=

# MyScript iInk Configuration (for handwriting recognition)
NEXT_PUBLIC_MYSCRIPT_APP_KEY=
NEXT_PUBLIC_MYSCRIPT_HMAC_KEY=

# Google OAuth (for Gmail)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Microsoft OAuth (for Outlook + Teams)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/auth/microsoft/callback
MICROSOFT_TENANT_ID=common

# Woodpecker Token Encryption
